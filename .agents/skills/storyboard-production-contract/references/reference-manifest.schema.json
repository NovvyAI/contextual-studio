{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contextual-ad/reference-manifest.schema.json",
  "title": "ReferenceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "creative_id", "references", "review_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "manifest_id": {"$ref": "#/$defs/id"}, "creative_id": {"$ref": "#/$defs/id"},
    "references": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reference_id", "role", "authority", "source_type", "uri", "rights_status", "allowed_use", "forbidden_use", "applicable_node_ids", "applicable_shot_ids"],
        "properties": {
          "reference_id": {"$ref": "#/$defs/id"},
          "role": {"enum": ["fact_evidence", "identity", "wardrobe", "environment", "gameplay_state", "brand", "narrative_structure", "emotion", "performance", "camera_language", "action", "visual_style", "quality_bar"]},
          "authority": {"enum": ["source_drama", "official_product", "approved_brand", "licensed_reference", "inspiration_only"]},
          "source_type": {"enum": ["local_image", "local_video", "official_url", "licensed_url", "document", "generated_previs"]},
          "uri": {"type": "string", "minLength": 1}, "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "rights_status": {"enum": ["authorized", "provided", "licensed", "reference_only", "unknown", "restricted"]},
          "allowed_use": {"type": "array", "items": {"type": "string"}}, "forbidden_use": {"type": "array", "items": {"type": "string"}},
          "applicable_node_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "applicable_shot_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "retrieved_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
          "expires_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
        }
      }
    },
    "review_status": {"enum": ["draft", "in_review", "approved", "needs_revision", "rejected"]}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}
}
