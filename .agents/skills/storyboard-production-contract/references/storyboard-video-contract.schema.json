{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contextual.storyboard-video.contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "shots"],
  "properties": {
    "schemaVersion": { "const": "contextual.storyboard-video.v1" },
    "shots": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["shotId", "order", "durationSeconds", "reviewZh", "promptEn"],
        "properties": {
          "shotId": { "type": "string", "pattern": "^shot-0[1-3]$" },
          "order": { "type": "integer", "minimum": 1, "maximum": 3 },
          "durationSeconds": { "type": "integer", "minimum": 4, "maximum": 15 },
          "reviewZh": { "type": "string", "minLength": 40 },
          "promptEn": { "type": "string", "minLength": 80 }
        }
      }
    }
  }
}
