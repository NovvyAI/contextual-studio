{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contextual-ad/creative-production-dossier.schema.json",
  "title": "CreativeProductionDossierManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dossier_id", "creative_id", "generated_at", "source_contracts", "sections", "rendered_artifact", "manual_source_of_truth", "review_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "dossier_id": {"$ref": "#/$defs/id"}, "creative_id": {"$ref": "#/$defs/id"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_contracts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["contract_type", "path", "sha256", "version"], "properties": {"contract_type": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/absolutePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "version": {"type": "string", "minLength": 1}}}},
    "sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["selling_point", "creative_summary", "outline", "script", "characters", "relationships", "world_rules", "rhythm", "image_tone", "storyboard", "art_style", "production_design", "props", "lighting", "directing", "color_grade", "editing", "perspective", "blocking", "performance", "camera_choreography", "scene_system_3d", "transition_effects", "visual_effects", "game_ui", "audio_music", "material_handoffs", "risk_compliance"]}},
    "rendered_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "format"], "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "format": {"enum": ["xlsx", "pdf", "html", "docx"]}}},
    "manual_source_of_truth": {"const": false},
    "review_status": {"enum": ["draft", "in_review", "approved", "needs_revision", "rejected"]}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "absolutePath": {"type": "string", "pattern": "^/"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}
}
