{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contextual-ad/drama-understanding-package.schema.json",
  "title": "DramaUnderstandingPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_id", "series_id", "created_at",
    "source_assets", "series", "characters", "episodes", "audiovisual_archive", "evidence", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_id": {"$ref": "#/$defs/id"},
    "series_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_assets": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/sourceAsset"}
    },
    "series": {"$ref": "#/$defs/series"},
    "characters": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/character"}
    },
    "episodes": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/episode"}
    },
    "audiovisual_archive": {"$ref": "#/$defs/audiovisualArchive"},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "status": {"enum": ["draft", "in_review", "approved", "blocked", "superseded"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "absolutePath": {"type": "string", "pattern": "^/"},
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "timecode": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?$"},
    "audiovisualArchive": {
      "type": "object", "additionalProperties": false,
      "required": ["series_storyline_summary", "episode_records"],
      "properties": {
        "series_storyline_summary": {"type": "string", "minLength": 1},
        "episode_records": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": [
              "episode_id", "single_episode_storyline", "segment_descriptions", "ending_hook_analysis",
              "ending_keyframe_evidence_id", "next_opening_hook", "keyframe_evidence_ids", "emotion_profile",
              "genre_tags", "story_archetypes", "visual_style", "character_turnarounds"
            ],
            "properties": {
              "episode_id": {"$ref": "#/$defs/id"},
              "single_episode_storyline": {"type": "string", "minLength": 1},
              "segment_descriptions": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["scene_id", "start", "end", "visual_elements", "camera_language", "environment", "props", "wardrobe", "composition_light", "sound"],
                  "properties": {
                    "scene_id": {"$ref": "#/$defs/id"}, "start": {"$ref": "#/$defs/timecode"}, "end": {"$ref": "#/$defs/timecode"},
                    "visual_elements": {"type": "array", "items": {"type": "string"}}, "camera_language": {"type": "string"},
                    "environment": {"type": "string"}, "props": {"type": "array", "items": {"type": "string"}},
                    "wardrobe": {"type": "array", "items": {"type": "string"}}, "composition_light": {"type": "string"}, "sound": {"type": "string"}
                  }
                }
              },
              "ending_hook_analysis": {
                "type": "object", "additionalProperties": false,
                "required": ["hook_logic", "suspense", "emotion_landing", "foreshadow", "audience_expectation"],
                "properties": {
                  "hook_logic": {"type": "string"}, "suspense": {"type": "string"}, "emotion_landing": {"type": "string"},
                  "foreshadow": {"type": "string"}, "audience_expectation": {"type": "string"}
                }
              },
              "ending_keyframe_evidence_id": {"$ref": "#/$defs/id"},
              "next_opening_hook": {
                "anyOf": [
                  {"type": "null"},
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["first_three_seconds", "attention_driver", "character_state", "evidence_ids"],
                    "properties": {
                      "first_three_seconds": {"type": "string"}, "attention_driver": {"type": "string"}, "character_state": {"type": "string"},
                      "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}
                    }
                  }
                ]
              },
              "keyframe_evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
              "emotion_profile": {
                "type": "object", "additionalProperties": false,
                "required": ["dominant", "peaks", "lows"],
                "properties": {
                  "dominant": {"type": "array", "items": {"type": "string"}},
                  "peaks": {"type": "array", "items": {"$ref": "#/$defs/timecode"}},
                  "lows": {"type": "array", "items": {"$ref": "#/$defs/timecode"}}
                }
              },
              "genre_tags": {"type": "array", "items": {"type": "string"}},
              "story_archetypes": {"type": "array", "items": {"type": "string"}},
              "visual_style": {"type": "string", "minLength": 1},
              "character_turnarounds": {
                "type": "array", "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["character_id", "evidence_ids"],
                  "properties": {
                    "character_id": {"$ref": "#/$defs/id"},
                    "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "sourceAsset": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "path", "sha256", "rights_status"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rights_status": {"enum": ["authorized", "provided", "licensed", "unknown", "restricted"]}
      }
    },
    "series": {
      "type": "object", "additionalProperties": false,
      "required": [
        "title", "synopsis", "genre_tags", "story_archetypes", "themes",
        "world_rules", "visual_style_summary", "audience_viewing_psychology"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1}, "synopsis": {"type": "string", "minLength": 1},
        "genre_tags": {"type": "array", "items": {"type": "string"}},
        "story_archetypes": {"type": "array", "items": {"type": "string"}},
        "themes": {"type": "array", "items": {"type": "string"}},
        "world_rules": {"type": "array", "items": {"type": "string"}},
        "visual_style_summary": {"type": "string", "minLength": 1},
        "audience_viewing_psychology": {"type": "string", "minLength": 1}
      }
    },
    "character": {
      "type": "object", "additionalProperties": false,
      "required": [
        "character_id", "name", "role", "personality", "backstory",
        "current_goal", "current_pressure", "relationships",
        "behavior_constraints", "visual_evidence_ids"
      ],
      "properties": {
        "character_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "personality": {"type": "array", "items": {"type": "string"}},
        "backstory": {"type": "string"}, "current_goal": {"type": "string", "minLength": 1},
        "current_pressure": {"type": "string", "minLength": 1},
        "relationships": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["other_character_id", "state"],
            "properties": {"other_character_id": {"$ref": "#/$defs/id"}, "state": {"type": "string"}}
          }
        },
        "behavior_constraints": {"type": "array", "items": {"type": "string"}},
        "visual_evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "emotionPoint": {
      "type": "object", "additionalProperties": false,
      "required": ["timecode", "character_emotion", "audience_emotion", "intensity"],
      "properties": {
        "timecode": {"$ref": "#/$defs/timecode"}, "character_emotion": {"type": "string"},
        "audience_emotion": {"type": "string"}, "intensity": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": [
        "scene_id", "start", "end", "location", "time_of_day", "character_ids",
        "action", "emotion_change", "dialogue_summary", "evidence_ids"
      ],
      "properties": {
        "scene_id": {"$ref": "#/$defs/id"}, "start": {"$ref": "#/$defs/timecode"},
        "end": {"$ref": "#/$defs/timecode"}, "location": {"type": "string"},
        "time_of_day": {"type": "string"},
        "character_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "action": {"type": "string"}, "emotion_change": {"type": "string"},
        "dialogue_summary": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["episode_id", "source_id", "summary", "scenes", "ending", "emotion_arc", "insertion_windows"],
      "properties": {
        "episode_id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"},
        "summary": {"type": "string", "minLength": 1},
        "scenes": {"type": "array", "items": {"$ref": "#/$defs/scene"}},
        "ending": {
          "type": "object", "additionalProperties": false,
          "required": [
            "narrative_end_timecode", "last_spoken_line", "character_state",
            "audience_open_loop", "hook_type", "anchor_evidence_id"
          ],
          "properties": {
            "narrative_end_timecode": {"$ref": "#/$defs/timecode"},
            "last_spoken_line": {"type": "string"}, "character_state": {"type": "string"},
            "audience_open_loop": {"type": "string"}, "hook_type": {"type": "string"},
            "anchor_evidence_id": {"$ref": "#/$defs/id"}
          }
        },
        "next_episode_opening": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["episode_id", "first_three_seconds", "character_state", "sound_field", "evidence_ids"],
              "properties": {
                "episode_id": {"$ref": "#/$defs/id"}, "first_three_seconds": {"type": "string"},
                "character_state": {"type": "string"}, "sound_field": {"type": "string"},
                "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
              }
            }
          ]
        },
        "emotion_arc": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/emotionPoint"}},
        "insertion_windows": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["start", "end", "reason", "risk"],
            "properties": {"start": {"$ref": "#/$defs/timecode"}, "end": {"$ref": "#/$defs/timecode"}, "reason": {"type": "string"}, "risk": {"type": "string"}}
          }
        }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source_id", "timecode", "kind", "path", "sha256", "claim", "confidence"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"},
        "timecode": {"$ref": "#/$defs/timecode"},
        "kind": {"enum": ["frame", "audio", "subtitle", "transcript", "contact_sheet"]},
        "path": {"$ref": "#/$defs/absolutePath"}, "sha256": {"$ref": "#/$defs/sha256"},
        "claim": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
