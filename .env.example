# 留空时使用本机 Codex 配置中的默认模型
CODEX_ANALYSIS_MODEL=
PORT=4180

# 云端部署时由 Secret Manager 注入；本机留空会读取已安装 Novvy plugin 的 .mcp.json。
NOVVY_MCP_URL=https://developer.novvy.ai/mcp
NOVVY_MCP_AUTHORIZATION=

# 可选的视频生成供应商。密钥只从环境变量或 Secret Manager 注入。
IMAROUTER_API_KEY=
IMAROUTER_BASE_URL=https://api.imarouter.com
IMAROUTER_GCS_BUCKET=novvy-seedance-public
