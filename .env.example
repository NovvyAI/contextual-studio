# 留空时使用本机 Codex 配置中的默认模型
CODEX_ANALYSIS_MODEL=
# 每一集短剧等待 Codex 分析结果的最长分钟数；默认 60，最大 1440。
DRAMA_ANALYSIS_TIMEOUT_MINUTES=60
PORT=4180

# 云端部署时由 Secret Manager 注入；本机留空会读取已安装 Novvy plugin 的 .mcp.json。
NOVVY_MCP_URL=https://developer.novvy.ai/mcp
NOVVY_MCP_AUTHORIZATION=

# Novvy AI Analysis API：创意工作台"从云端已解析短剧/App 选择"入口读取已完成的远端解析目录。
# 留空 AI_ANALYSIS_API_KEY 时该入口会报错，不影响本地上传短剧/提交商店链接分析的原有流程。
AI_ANALYSIS_API_BASE_URL=https://developer.novvy.ai
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_API_TIMEOUT_MS=30000
AI_ANALYSIS_API_CACHE_TTL_MS=300000

# 可选的视频生成供应商。密钥只从环境变量或 Secret Manager 注入。
IMAROUTER_API_KEY=
IMAROUTER_BASE_URL=https://api.imarouter.com
IMAROUTER_GCS_BUCKET=novvy-seedance-public

# 可选：团队创意过程采集。留空时事件只保存在本地 SQLite outbox，不影响创作流程。
NOVVY_TELEMETRY_URL=
NOVVY_TELEMETRY_TOKEN=
NOVVY_TELEMETRY_USER_ID=
NOVVY_SKILL_VERSION=contextual-studio-v1
NOVVY_TELEMETRY_TIMEOUT_MS=15000

# 可选：本地采集服务，仅用于开发和公司远端尚未部署时。
LOCAL_TELEMETRY_PORT=4191
LOCAL_TELEMETRY_TOKEN=contextual-local-dev

# 可选：MLflow GenAI tracing。安装后本地 UI 默认监听 5000；正式埋点还需配置 experiment ID。
MLFLOW_TRACKING_URI=http://127.0.0.1:5050
MLFLOW_PORT=5050
MLFLOW_EXPERIMENT_ID=
MLFLOW_TRACE_MAX_STRING_LENGTH=200000
